<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg_clear">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/w_ttitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tareas"
            android:textColor="#F4EFE3"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:shadowColor="#B3000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4" />

        <ImageView
            android:id="@+id/w_tmic"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="4dp"
            android:src="@drawable/ic_mic_gold"
            android:contentDescription="Apunta día" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_tlist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#E9E2CF"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        android:maxLines="9"
        android:ellipsize="end"
        android:shadowColor="#B3000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4" />
</LinearLayout>
